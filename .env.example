# Copy this file to .env and change the values.
PORT=3000
NODE_ENV=development
# Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string
# SQLite database file (created automatically)
DATABASE_FILE=./database/inventory.db
# Maximum laptop image size in MB
MAX_UPLOAD_MB=3
# Set to true only when serving over HTTPS
COOKIE_SECURE=false
